# Public test defaults for the shared local PostgreSQL server.
# Environment variables override these.
MAN_ENV=test
MAN_PASSWORD=test-only-password
MAN_POSTGRES_USER=man
MAN_POSTGRES_PWD=man
MAN_POSTGRES_HOST=127.0.0.1
MAN_POSTGRES_PORT=5432
MAN_POSTGRES_DATABASE=man_test
MAN_CORS_ORIGINS='["http://localhost:3000", "http://test"]'
